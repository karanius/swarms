{
  "schema_version": "1.0-contract",
  "business_id": "local-content-business",
  "instance_id": "market-intelligence",
  "revision": 1,
  "status": "specified-not-implemented",
  "operations_plane": {
    "ref": "local-content-business/operations",
    "role": "enclosing coordination plane"
  },
  "instance_contract": {
    "purpose": "Source-grounded audience problem and existing-solution intelligence for Content Strategy",
    "external_inputs": {
      "brief": "brief"
    },
    "external_outputs": {
      "dossier": "assemble.dossier",
      "review": "review.review",
      "handoff": "handoff.receipt",
      "obligations": "observer.obligations",
      "costs": "observer.costs"
    },
    "completion_outcomes": [
      "accepted_and_acknowledged",
      "accepted_delivery_pending",
      "rejected_with_reason",
      "insufficient_with_evidence_limits",
      "blocked_with_obligations",
      "cancelled_with_costs"
    ],
    "forbidden_decisions": [
      "choose the entire business without owner decision",
      "publish content",
      "spend money",
      "open/change accounts",
      "claim demand or profitability from source counts"
    ]
  },
  "processes": [
    {
      "id": "P1",
      "name": "Govern investigation",
      "flow_refs": [
        "investigate"
      ],
      "owns_nodes": [
        "intake"
      ],
      "owner_role": "intelligence_owner"
    },
    {
      "id": "P2",
      "name": "Investigate opportunity",
      "flow_refs": [
        "investigate"
      ],
      "owns_nodes": [
        "discover",
        "retrieve",
        "normalize",
        "compare",
        "form_claims",
        "assess"
      ],
      "owner_role": "intelligence_owner"
    },
    {
      "id": "P3",
      "name": "Review and handoff",
      "flow_refs": [
        "investigate"
      ],
      "owns_nodes": [
        "assemble",
        "review",
        "handoff"
      ],
      "owner_role": "evidence_reviewer"
    },
    {
      "id": "P4",
      "name": "Refresh and revise",
      "flow_refs": [
        "refresh"
      ],
      "owns_nodes": [
        "impact"
      ],
      "owner_role": "intelligence_owner"
    },
    {
      "id": "P5",
      "name": "Cost, access and privacy stewardship",
      "flow_refs": [
        "investigate",
        "refresh"
      ],
      "owns_nodes": [],
      "observer_refs": [
        "attempt-observer"
      ],
      "owner_role": "operations_owner"
    }
  ],
  "flows": [
    {
      "id": "investigate",
      "external_inputs": {
        "brief": "brief"
      },
      "nodes": [
        {
          "id": "intake",
          "composite_ref": "K01",
          "bindings": {
            "brief": "input.brief"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "runtime_ready",
          "additional_gate": null
        },
        {
          "id": "discover",
          "composite_ref": "K02",
          "bindings": {
            "plan": "intake.plan"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "retrieve",
          "composite_ref": "K03",
          "bindings": {
            "plan": "intake.plan",
            "candidates": "discover.candidates"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "normalize",
          "composite_ref": "K04",
          "bindings": {
            "sources": "retrieve.sources"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "compare",
          "composite_ref": "K05",
          "bindings": {
            "brief": "input.brief",
            "evidence": "normalize.evidence"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "form_claims",
          "composite_ref": "K06",
          "bindings": {
            "brief": "input.brief",
            "evidence": "normalize.evidence",
            "alternatives": "compare.alternatives"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "assess",
          "composite_ref": "K07",
          "bindings": {
            "candidates": "form_claims.candidates",
            "evidence": "normalize.evidence",
            "alternatives": "compare.alternatives"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "assemble",
          "composite_ref": "K08",
          "bindings": {
            "brief": "input.brief",
            "plan": "intake.plan",
            "evidence": "normalize.evidence",
            "alternatives": "compare.alternatives",
            "assessments": "assess.assessments",
            "obligations": "observer.obligations",
            "costs": "observer.costs"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "review",
          "composite_ref": "K09",
          "bindings": {
            "brief": "input.brief",
            "plan": "intake.plan",
            "candidates": "discover.candidates",
            "sources": "retrieve.sources",
            "alternatives": "compare.alternatives",
            "dossier": "assemble.dossier",
            "evidence": "normalize.evidence",
            "assessments": "assess.assessments"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": null
        },
        {
          "id": "handoff",
          "composite_ref": "K10",
          "bindings": {
            "dossier": "assemble.dossier",
            "review": "review.review"
          },
          "observer_ref": "attempt-observer",
          "failure_route": "record_then_block_or_bounded_retry",
          "entry_gate": "dependencies_accepted",
          "additional_gate": "review_accepts_exact_revision"
        }
      ],
      "result_bindings": {
        "dossier": "assemble.dossier",
        "review": "review.review",
        "receipt": "handoff.receipt"
      }
    },
    {
      "id": "refresh",
      "external_inputs": {
        "notice": "change_notice",
        "parent": "dossier"
      },
      "nodes": [
        {
          "id": "impact",
          "composite_ref": "K11",
          "bindings": {
            "notice": "input.notice",
            "parent": "input.parent"
          },
          "observer_ref": "attempt-observer",
          "entry_gate": "runtime_ready",
          "failure_route": "record_then_block_or_bounded_retry",
          "additional_gate": null
        }
      ],
      "result_bindings": {
        "impact": "impact.impact",
        "revision": "impact.revision"
      },
      "next_flow": {
        "ref": "investigate",
        "condition": "owner approves revised brief based on impact",
        "revision_boundary": true,
        "input_construction": "New brief explicitly records parent dossier and amendment; never reuse a stale accepted plan implicitly"
      }
    }
  ],
  "composites": [
    {
      "id": "K01",
      "name": "Brief-to-plan",
      "input_ports": {
        "brief": "brief"
      },
      "output_ports": {
        "plan": "plan",
        "obligations": "obligation_set"
      },
      "responsibility": "Frame a research plan without inventing limits",
      "acceptance_policy": "brief_schema_and_authority",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K02",
      "name": "Source discovery",
      "input_ports": {
        "plan": "plan"
      },
      "output_ports": {
        "candidates": "discovery_batch"
      },
      "responsibility": "Translate declared queries into screened candidate source locations",
      "acceptance_policy": "discovery_scope_and_coverage",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K03",
      "name": "Evidence retrieval",
      "input_ports": {
        "plan": "plan",
        "candidates": "discovery_batch"
      },
      "output_ports": {
        "sources": "source_batch"
      },
      "responsibility": "Retrieve permitted original evidence and preserve failures",
      "acceptance_policy": "retrieval_provenance",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K04",
      "name": "Normalize and group evidence",
      "input_ports": {
        "sources": "source_batch"
      },
      "output_ports": {
        "evidence": "evidence_set"
      },
      "responsibility": "Preserve observations, transformations and uncertain source-family dependence",
      "acceptance_policy": "normalization_and_independence",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K05",
      "name": "Existing-solution comparison",
      "input_ports": {
        "brief": "brief",
        "evidence": "evidence_set"
      },
      "output_ports": {
        "alternatives": "alternative_set"
      },
      "responsibility": "Find strong competing solutions and explanations",
      "acceptance_policy": "alternative_fairness",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K06",
      "name": "Candidate claim formation",
      "input_ports": {
        "brief": "brief",
        "evidence": "evidence_set",
        "alternatives": "alternative_set"
      },
      "output_ports": {
        "candidates": "candidate_claims"
      },
      "responsibility": "Explicitly separate observation, inference and hypothesis",
      "acceptance_policy": "candidate_scope",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K07",
      "name": "Evidence judgment",
      "input_ports": {
        "candidates": "candidate_claims",
        "evidence": "evidence_set",
        "alternatives": "alternative_set"
      },
      "output_ports": {
        "assessments": "assessment_set"
      },
      "responsibility": "Judge support, contradiction, scope and missing evidence",
      "acceptance_policy": "evidence_judgment",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K08",
      "name": "Dossier assembly",
      "input_ports": {
        "brief": "brief",
        "plan": "plan",
        "evidence": "evidence_set",
        "alternatives": "alternative_set",
        "assessments": "assessment_set",
        "obligations": "obligation_set",
        "costs": "cost_ledger"
      },
      "output_ports": {
        "dossier": "dossier"
      },
      "responsibility": "Assemble a traceable recommendation without replacing evidence",
      "acceptance_policy": "dossier_completeness",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K09",
      "name": "Independent review",
      "input_ports": {
        "brief": "brief",
        "plan": "plan",
        "candidates": "discovery_batch",
        "sources": "source_batch",
        "alternatives": "alternative_set",
        "dossier": "dossier",
        "evidence": "evidence_set",
        "assessments": "assessment_set"
      },
      "output_ports": {
        "review": "review_decision"
      },
      "responsibility": "Accept, reject or request rework against declared criteria",
      "acceptance_policy": "review_acceptance",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K10",
      "name": "Versioned handoff",
      "input_ports": {
        "dossier": "dossier",
        "review": "review_decision"
      },
      "output_ports": {
        "receipt": "handoff_receipt"
      },
      "responsibility": "Deliver accepted exact revision and record acknowledgment or failure",
      "acceptance_policy": "handoff_authority",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    },
    {
      "id": "K11",
      "name": "Change-impact analysis",
      "input_ports": {
        "notice": "change_notice",
        "parent": "dossier"
      },
      "output_ports": {
        "impact": "impact_report",
        "revision": "revision_request"
      },
      "responsibility": "Trace changed evidence and request a new revision",
      "acceptance_policy": "revision_fidelity",
      "internal_graph": null,
      "native_occurrence_refs": [],
      "status": "contract-only"
    }
  ],
  "components": {
    "native_occurrences": [],
    "resource_adapters": [],
    "grounding_status": "deferred",
    "required_resource_roles": [
      "permitted-source discovery",
      "retrieval and snapshot store",
      "deterministic parsing",
      "evidence family review",
      "local synthesis model",
      "schema and cross-artifact validator",
      "artifact registry",
      "scoped review and delivery"
    ],
    "grounding_gate": [
      "actual pinned native catalog",
      "actual adapter contracts",
      "model/checkpoint rights",
      "typed port validation",
      "bounded runtime behavior proof"
    ],
    "note": "These roles are not claimed native Langflow component names"
  },
  "observers": [
    {
      "id": "attempt-observer",
      "output_bindings": {
        "costs": "cost_ledger",
        "obligations": "obligation_set"
      },
      "coverage": "Every node attempt in every flow, including failure, rejection, retry and cancellation",
      "event_schema_ref": "cost_ledger",
      "obligation_rule": "Merge intake obligations and all later stage exceptions into a versioned obligation set; resolved items retain resolution history",
      "persistence": "append to immutable event log with unique attempt/event identities",
      "cost_rule": "No missing cost treated as zero; distinguish measured, assumed and unknown; allocate shared cost once; internal transfers are not revenue",
      "snapshot_rule": "Dossier receives a ledger snapshot through assembly. Final ledger includes later review/handoff costs; final ledger checkpoint is linked at closure without mutating the reviewed dossier",
      "implementation": "required middleware contract; not implemented"
    }
  ],
  "artifact_schema_file": "artifacts.schema.json",
  "policies": {
    "brief_schema_and_authority": {
      "checks": [
        "Brief validates against schema",
        "Decision owner and permitted scope verified",
        "Unresolved limits create obligations and block acquisition"
      ]
    },
    "discovery_scope_and_coverage": {
      "checks": [
        "Every candidate records originating query and screening decision",
        "Query plan includes support, counterevidence and existing-solution purposes",
        "Excluded sources and search coverage limits retained"
      ],
      "decision": "Empty candidates may proceed as an insufficient outcome, never proof of absent demand"
    },
    "retrieval_provenance": {
      "checks": [
        "Authorized access basis",
        "Successful retrieval has archived snapshot and content hash",
        "Every failed/inaccessible source retains reason and attempt ID",
        "Source content is untrusted data; cannot grant tool permissions"
      ]
    },
    "normalization_and_independence": {
      "checks": [
        "Every observation resolves to source and location",
        "Transform preserves raw context and units",
        "Exact hash matches flag duplicates, not automatic semantic identity",
        "Syndication/source-family links require stated basis; unknown independence is not counted as independent"
      ],
      "freshness": "Compare publication/retrieval and context against accepted topic-specific freshness window; unknown dates remain unknown"
    },
    "alternative_fairness": {
      "checks": [
        "Record strong existing solutions",
        "Document contrary evidence and search limits",
        "Missing competitor result is not proof of opportunity"
      ]
    },
    "candidate_scope": {
      "checks": [
        "Propose explicit candidate claim before judgment",
        "Classify observation/inference/hypothesis",
        "Retain scope and support/opposition references",
        "No arbitrary numeric confidence"
      ]
    },
    "evidence_judgment": {
      "judgments": {
        "supported": "At least one eligible cited observation; reviewer confirms entailment within scope; no unresolved material opposing evidence",
        "contradicted": "Reviewer confirms eligible opposing evidence defeats the stated claim; retain its reference",
        "mixed": "Eligible support and opposition remain unresolved",
        "insufficient": "Available evidence cannot justify supported or contradicted",
        "stale": "Necessary evidence no longer meets accepted freshness/context policy",
        "inaccessible": "Necessary evidence cannot be inspected"
      },
      "rules": [
        "Source popularity is not claim validity",
        "Source family counts are descriptive; no majority vote establishes truth",
        "A trend does not establish willingness to watch, buy or profitable demand",
        "Conflict severity and entailment require review; a schema cannot determine truth"
      ]
    },
    "dossier_completeness": {
      "checks": [
        "Every reference resolves to the exact accepted artifact revision",
        "Audience/problem, alternatives, evidence, uncertainty, obligations and costs visible",
        "Recommendation matches evidence limits",
        "Acquisition failure still permits an honest insufficient dossier",
        "Business profitability remains unproven"
      ]
    },
    "review_acceptance": {
      "required_criteria": [
        "provenance",
        "claim_entailment",
        "counterevidence",
        "source_dependence",
        "scope_and_missingness",
        "cost_and_limits",
        "privacy_and_rights"
      ],
      "decision": "Accept only if all critical criteria pass and zero critical unresolved findings; rework creates child revision; reviewer may be human or separately authorized assistant with accountable human acceptance owner",
      "independence": "No self-approval; separate reviewer occurrence/context; disclose shared-model bias"
    },
    "handoff_authority": {
      "checks": [
        "Accepted review references exact dossier revision",
        "Recipient and access classification authorized",
        "Idempotency key is business+instance+artifact+revision+recipient",
        "Acknowledgment distinguishes delivered from accepted",
        "Failed delivery does not erase accepted dossier"
      ]
    },
    "revision_fidelity": {
      "checks": [
        "Parent revision immutable",
        "Impact lists affected claims and consumers",
        "New brief/attempt references parent and amendment reason",
        "Consumer notifications have acknowledgment records",
        "Unrelated artifacts do not change"
      ]
    }
  },
  "configuration": {
    "design_mode": true,
    "required_before_activation": {
      "audience_job": null,
      "language": null,
      "geography": null,
      "time_window": null,
      "source_connectors": null,
      "allowed_sources": null,
      "freshness_window": null,
      "time_cap_seconds": null,
      "cash_cap_amount": null,
      "currency": null,
      "max_attempts_per_node": null,
      "max_concurrent_retrievals": null,
      "retention_policy": null,
      "storage_binding": null,
      "review_acceptance_owner": null
    },
    "role_bindings": {
      "intelligence_owner": null,
      "evidence_reviewer": null,
      "operations_owner": null
    },
    "runtime_bindings": {
      "model_revision": null,
      "runtime": null,
      "secret_refs": []
    },
    "side_effects": {
      "publication": false,
      "spending": false,
      "account_changes": false
    },
    "local_generation": "Local synthesis requirement must be verified at runtime; source retrieval and other services may be online",
    "unknown_gate": "Required unresolved activation values block acquisition; dry contract validation remains permitted"
  },
  "persistence_contract": {
    "artifacts": "Immutable artifact ID+revision; content hash plus schema version",
    "events": "Append-only attempt log; causal run/attempt IDs and real timestamps",
    "checkpoints": "Persist accepted node outputs; resume only when input hashes, configuration revision and permissions match",
    "concurrency": "Per-run revision compare-and-swap and idempotency keys; bounded worker leases; rejected stale writes recorded",
    "reference_resolution": "Artifact ID+revision+type resolves to stored record; no source URL substitutes for immutable content",
    "retention": "Owner-set policy by classification; legitimate deletion leaves tombstone/access status rather than dangling invented evidence",
    "implementation": "not implemented"
  },
  "handoffs": [
    {
      "sender": "operations",
      "recipient": "market-intelligence",
      "artifact": "brief",
      "rule": "Authenticated scope/limits and acceptance authority"
    },
    {
      "sender": "audience-care",
      "recipient": "market-intelligence",
      "artifact": "change_notice",
      "rule": "Deidentified evidence with authority and source limits"
    },
    {
      "sender": "finance-performance",
      "recipient": "market-intelligence",
      "artifact": "change_notice",
      "rule": "Metrics retain cohort, period, denominator and uncertainty; invalid evidence is rejected"
    },
    {
      "sender": "market-intelligence",
      "recipient": "content-strategy",
      "artifact": "dossier",
      "rule": "Exact revision plus review; recipient acknowledgment required"
    },
    {
      "sender": "market-intelligence",
      "recipient": "finance-performance",
      "artifact": "cost_ledger",
      "rule": "Final costs including review/handoff; snapshot vs final distinguished"
    },
    {
      "sender": "market-intelligence",
      "recipient": "operations",
      "artifact": "obligation_set",
      "rule": "Blocked scope/access/budget or policy decisions escalated"
    }
  ],
  "readiness": {
    "json_contract": "subject to validation",
    "native_graph": "unbound",
    "source_access": "unverified",
    "model_inference": "unverified",
    "market_evidence": "none collected",
    "business_value": "untested"
  },
  "guards": {
    "runtime_ready": {
      "all": [
        "configuration_resolved",
        "roles_authorized",
        "components_grounded",
        "access_authorized",
        "budget_reserved"
      ]
    },
    "dependencies_accepted": {
      "all": [
        "inputs_schema_valid",
        "references_resolved",
        "upstream_accepted",
        "budget_remaining"
      ]
    },
    "review_accepts_exact_revision": {
      "all": [
        "review_accepted",
        "review_matches_dossier_revision",
        "recipient_authorized",
        "critical_checks_passed"
      ]
    },
    "may_review": {
      "all": [
        "dossier_schema_valid",
        "references_resolved",
        "reviewer_authorized",
        "reviewer_separate_from_author"
      ]
    },
    "may_accept": {
      "all": [
        "critical_checks_passed",
        "zero_critical_findings",
        "reviewer_authorized"
      ]
    },
    "may_revise": {
      "all": [
        "parent_record_preserved",
        "new_revision_assigned",
        "amendment_recorded",
        "owner_approved"
      ]
    },
    "may_acknowledge": {
      "all": [
        "recipient_authorized",
        "ack_matches_revision",
        "idempotency_checked"
      ]
    }
  },
  "guard_context_contract": {
    "default": "Missing or unknown inputs evaluate false; no truth inferred from model text",
    "producers": {
      "configuration_resolved": "validated activation configuration",
      "roles_authorized": "authority registry",
      "components_grounded": "pinned catalog and runtime qualification",
      "access_authorized": "allowed source/account policy",
      "budget_reserved": "time/cash reservation ledger",
      "inputs_schema_valid": "JSON Schema validator",
      "references_resolved": "artifact registry",
      "upstream_accepted": "checkpoint registry",
      "budget_remaining": "live time/cash ledger",
      "review_accepted": "review_decision",
      "review_matches_dossier_revision": "artifact reference comparison",
      "recipient_authorized": "authority registry",
      "critical_checks_passed": "complete review rubric",
      "dossier_schema_valid": "JSON Schema validator",
      "reviewer_authorized": "authority registry",
      "reviewer_separate_from_author": "actor and context separation record",
      "zero_critical_findings": "review_decision",
      "parent_record_preserved": "artifact registry",
      "new_revision_assigned": "revision allocator",
      "amendment_recorded": "revision record",
      "owner_approved": "approval record",
      "ack_matches_revision": "handoff_receipt",
      "idempotency_checked": "delivery registry"
    }
  },
  "lifecycle": {
    "states": [
