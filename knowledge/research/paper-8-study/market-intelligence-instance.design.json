{
  "schema_version": "0.1-design",
  "id": "market-intelligence",
  "revision": 1,
  "status": "proposed-not-implemented",
  "operations_plane": {
    "business_ref": "paper7-local-content-business",
    "role": "enclosing shared coordination plane",
    "instance_ref": "market-intelligence"
  },
  "instance_contract": {
    "purpose": "Investigate audience problems and existing solutions; deliver traceable opportunity dossiers",
    "inputs": [
      "research_brief",
      "change_notice"
    ],
    "outputs": [
      "opportunity_dossier",
      "handoff_record",
      "cost_event",
      "open_obligations"
    ],
    "decisions_owned": [
      "evidence judgments",
      "research scope within accepted brief",
      "bounded continue/narrow/ask/stop recommendations"
    ],
    "decisions_not_owned": [
      "business adoption",
      "public release",
      "spending",
      "account changes"
    ],
    "invariants": [
      "Trace every factual claim to evidence or label assumption",
      "Preserve contrary evidence and missingness",
      "No duplicate source families counted as independent by default",
      "New evidence creates a new revision",
      "No public or financial side effects"
    ],
    "completion": "Consumer accepts a versioned dossier or receives a reasoned blocked/insufficient outcome"
  },
  "processes": [
    {
      "id": "P1",
      "name": "Investigation governance",
      "trigger": "new or changed brief",
      "flow_refs": [
        "F1"
      ],
      "owner_role": "intelligence_owner",
      "exit": "accepted scoped plan or explicit clarification"
    },
    {
      "id": "P2",
      "name": "Opportunity investigation",
      "trigger": "accepted plan",
      "flow_refs": [
        "F2",
        "F3",
        "F4"
      ],
      "owner_role": "intelligence_owner",
      "exit": "evidence and challenged claims or bounded insufficient result"
    },
    {
      "id": "P3",
      "name": "Review and dossier handoff",
      "trigger": "candidate dossier",
      "flow_refs": [
        "F5"
      ],
      "owner_role": "evidence_reviewer",
      "exit": "accepted handoff or recorded rejection"
    },
    {
      "id": "P4",
      "name": "Freshness and revision",
      "trigger": "expiry, correction or new evidence",
      "flow_refs": [
        "F6"
      ],
      "owner_role": "intelligence_owner",
      "exit": "superseding revision and affected-consumer notice"
    },
    {
      "id": "P5",
      "name": "Cost and privacy stewardship",
      "trigger": "each attempt and access event",
      "flow_refs": [],
      "cross_cutting": true,
      "owner_role": "operations_owner",
      "exit": "cost/access record or escalated exception"
    }
  ],
  "flows": [
    {
      "id": "F1",
      "name": "Brief intake",
      "composite_refs": [
        "C1"
      ],
      "input_types": [
        "research_brief"
      ],
      "output_types": [
        "research_plan",
        "open_obligations"
      ],
      "implementation": "deferred"
    },
    {
      "id": "F2",
      "name": "Evidence acquisition",
      "composite_refs": [
        "C2"
      ],
      "input_types": [
        "research_plan"
      ],
      "output_types": [
        "source_record",
        "observation",
        "retrieval_event"
      ],
      "implementation": "deferred"
    },
    {
      "id": "F3",
      "name": "Normalize and assess",
      "composite_refs": [
        "C3"
      ],
      "input_types": [
        "source_record",
        "observation"
      ],
      "output_types": [
        "normalized_evidence",
        "source_family"
      ],
      "implementation": "deferred"
    },
    {
      "id": "F4",
      "name": "Synthesize and challenge",
      "composite_refs": [
        "C4",
        "C5"
      ],
      "input_types": [
        "normalized_evidence",
        "research_brief"
      ],
      "output_types": [
        "claim",
        "alternative"
      ],
      "implementation": "deferred"
    },
    {
      "id": "F5",
      "name": "Review and handoff",
      "composite_refs": [
        "C6"
      ],
      "input_types": [
        "claim",
        "alternative",
        "research_brief",
        "cost_event",
        "open_obligations"
      ],
      "output_types": [
        "opportunity_dossier",
        "handoff_record"
      ],
      "implementation": "deferred"
    },
    {
      "id": "F6",
      "name": "Refresh and revise",
      "composite_refs": [
        "C7"
      ],
      "input_types": [
        "change_notice",
        "opportunity_dossier"
      ],
      "output_types": [
        "impact_report",
        "revision_request"
      ],
      "implementation": "deferred"
    }
  ],
  "flow_dependencies": [
    {
      "from": "F1",
      "to": "F2",
      "condition": "accepted plan and access/limit gates pass"
    },
    {
      "from": "F2",
      "to": "F3",
      "condition": "available observations; failures remain recorded"
    },
    {
      "from": "F3",
      "to": "F4",
      "condition": "reviewable normalized evidence with independence/freshness limits"
    },
    {
      "from": "F4",
      "to": "F5",
      "condition": "challenged claims or explicit insufficient-evidence result"
    },
    {
      "from": "F5",
      "to": "F6",
      "condition": "accepted dossier later needs refresh",
      "revision_boundary": true
    },
    {
      "from": "F6",
      "to": "F1",
      "condition": "targeted revised brief; preserve parent history",
      "revision_boundary": true
    }
  ],
  "composite_contracts": [
    {
      "id": "C1",
      "name": "Brief-to-plan",
      "input_types": [
        "research_brief"
      ],
      "output_types": [
        "research_plan",
        "open_obligations"
      ],
      "acceptance": "No invented scope or authority",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C2",
      "name": "Source-to-observations",
      "input_types": [
        "research_plan",
        "source_locator"
      ],
      "output_types": [
        "source_record",
        "observation",
        "retrieval_event"
      ],
      "acceptance": "Actual source and access status; preserve failure",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C3",
      "name": "Evidence normalization",
      "input_types": [
        "source_record",
        "observation"
      ],
      "output_types": [
        "normalized_evidence",
        "source_family"
      ],
      "acceptance": "Preserve raw context and uncertain duplicate links",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C4",
      "name": "Problem and solution comparison",
      "input_types": [
        "research_brief",
        "normalized_evidence"
      ],
      "output_types": [
        "alternative"
      ],
      "acceptance": "Include strong existing solutions and contrary evidence",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C5",
      "name": "Claim assessment",
      "input_types": [
        "normalized_evidence",
        "alternative"
      ],
      "output_types": [
        "claim"
      ],
      "acceptance": "Support status and source entailment; no invented probability",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C6",
      "name": "Dossier assembly",
      "input_types": [
        "research_brief",
        "claim",
        "alternative",
        "cost_event",
        "open_obligations"
      ],
      "output_types": [
        "opportunity_dossier"
      ],
      "acceptance": "Expose missing evidence; no profitable-niche claim",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    },
    {
      "id": "C7",
      "name": "Change impact",
      "input_types": [
        "change_notice",
        "opportunity_dossier"
      ],
      "output_types": [
        "impact_report",
        "revision_request"
      ],
      "acceptance": "Trace affected claims and preserve unrelated revisions",
      "native_component_refs": [],
      "internal_wiring": null,
      "grounding_status": "unbound"
    }
  ],
  "components": {
    "native_occurrences": [],
    "resource_adapters": [],
    "status": "selection-and-wiring-deferred",
    "rule": "Only populate after actual pinned catalog and adapter verification"
  },
