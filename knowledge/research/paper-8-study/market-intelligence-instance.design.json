      [
        "in_review",
        "rejected"
      ],
      [
        "assessing",
        "insufficient"
      ],
      [
        "accepted",
        "superseded"
      ]
    ],
    "exception_rule": "Any active nonterminal state may become blocked or cancelled with a recorded reason; retry/rework creates a new attempt or revision",
    "missing_evidence_rule": "insufficient is an honest outcome, not proof of no demand"
  },
  "handoffs": [
    {
      "from": "Operations",
      "to": "market-intelligence",
      "artifact_types": [
        "research_brief"
      ],
      "authority": "scope and limit authorization"
    },
    {
      "from": "Audience Care",
      "to": "market-intelligence",
      "artifact_types": [
        "change_notice"
      ],
      "authority": "deidentified feedback evidence only"
    },
    {
      "from": "Finance and Performance",
      "to": "market-intelligence",
      "artifact_types": [
        "change_notice"
      ],
      "authority": "versioned metrics and resource context; no unsupported causal conclusion"
    },
    {
      "from": "market-intelligence",
      "to": "Content Strategy",
      "artifact_types": [
        "opportunity_dossier",
        "handoff_record"
      ],
      "authority": "recommendation; not automatic strategy adoption"
    },
    {
      "from": "market-intelligence",
      "to": "Finance and Performance",
      "artifact_types": [
        "cost_event"
      ],
      "authority": "actual research costs including failed attempts"
    },
    {
      "from": "market-intelligence",
      "to": "Operations",
      "artifact_types": [
        "open_obligations"
      ],
      "authority": "scope, budget and access exceptions"
    }
  ],
