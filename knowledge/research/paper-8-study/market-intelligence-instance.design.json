  "state_model": {
    "states": [
      "draft",
      "needs_clarification",
      "planned",
      "collecting",
      "assessing",
      "in_review",
      "accepted",
      "rejected",
      "insufficient",
      "blocked",
      "cancelled",
      "superseded"
    ],
    "transitions": [
      [
        "draft",
        "needs_clarification"
      ],
      [
        "draft",
        "planned"
      ],
      [
        "needs_clarification",
        "planned"
      ],
      [
        "planned",
        "collecting"
      ],
      [
        "collecting",
        "assessing"
      ],
      [
        "assessing",
        "in_review"
      ],
      [
        "in_review",
        "accepted"
