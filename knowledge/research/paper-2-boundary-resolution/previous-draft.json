                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A recorded alternative, clarification, partial result, or scoped blocked outcome.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
