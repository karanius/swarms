              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Clarify",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A requirement is ambiguous or missing a consequential decision.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A precise question or an explicitly labeled assumption; do not invent an answer.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Resolve a reference",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A configuration, resource, or version reference is missing or ambiguous.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A named binding or unresolved dependency record.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Decompose",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A requirement is too broad for available described capabilities.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Child requirements with a trace to the parent; preserve its acceptance obligations.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Reuse or select",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "An existing scoped item may address the requirement.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A referenced occurrence plus applicability judgments.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Compose horizontally",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A rule can propose compatible wiring within a layer.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A candidate graph, configuration, boundary, and residual obligations.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Package upward",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A candidate has a defined boundary and representational purpose.",
                    "styles": {}
