                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "A higher-layer occurrence referencing the same members; no implicit certification.",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              }
            ]
          },
          {
            "cells": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "Revise or stop",
                    "styles": {}
                  }
                ],
                "props": {
                  "colspan": 1,
                  "rowspan": 1,
                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                }
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "text",
                    "text": "The candidate conflicts, repeats a state, lacks evidence, or exhausts budget.",
                    "styles": {}
